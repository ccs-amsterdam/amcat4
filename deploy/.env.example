# This file is an example .env file for configuring AmCAT4 installed via the docker
# Copy this file to .env and edit the values below as needed


# # General settings
# Which docker image version to use? The release bundle (amcat4-deploy.zip) sets this to its own version.
# Set to 'latest' to always get the last available build (not recommended for servers: upgrades can need care)
# AMCAT4_VERSION=4.2.10

# What is the hostname for this machine?
# This is used by the caddy web server to serve the API and web interface
# Be sure to include https:// for servers that can be reached from outside
# For local testing, use http://localhost
# Note: Make sure not to include a trailing slash!
AMCAT4_URL=http://localhost

# Secret for signing the session cookies of the web client. Required when authentication is enabled (the server
# refuses to start without it); without a fixed secret, every restart would log out all users.
# Replace it with the output of: openssl rand -hex 32
AMCAT4_COOKIE_SECRET=please replace me with the output of openssl rand -hex 32

# # AmCAT API settings (copied from amcat4/.env.example)

# Do we require authorization?
# Valid options:
# - no_auth: everyone (that can reach the server) can do anything they want
# - allow_guests: everyone can use the server, dependent on index-level guest_role authorization settings
# - allow_authenticated_guests: everyone can use the server, if they have a valid middlecat login, and dependent on index-level guest_role authorization settings
amcat4_auth=no_auth

# Set an email address for a hardcoded admin email (useful for setup and recovery)
amcat4_admin_email=youremail@xample.com

# Which profile to use. Uncomment 'deploy' to run the full stack (caddy, api, postgres).
# Use 'deploy-nodb' to use your own (external) postgres server.
# Use 'dev' to run only the infrastructure services (postgres, seaweedfs) for local development.
COMPOSE_PROFILES=deploy

# Middlecat server to trust as ID provider
# amcat4_middlecat_url=https://middlecat.net

# Number of API worker processes (default: 4). More workers handle more simultaneous requests.
# AMCAT4_WORKERS=4

# All other API settings (see backend/amcat4/config.py) can also be set here, with the amcat4_ prefix, e.g.
# for multimedia storage in S3-compatible object storage:
# AMCAT4_S3_HOST=
# AMCAT4_S3_ACCESS_KEY=
# AMCAT4_S3_SECRET_KEY=

# # Database (PostgreSQL with the pg_search extension)

# Password for the internal postgres database (default: amcat). The database is only reachable from the docker
# network, but it is still a good idea to set a password, e.g. the output of `openssl rand -hex 16`
# (only use letters and digits, as it is used in a connection URL)
# POSTGRES_PASSWORD=

# Which paradedb (postgres + pg_search + pgvector) image to use (default: the version AmCAT was tested with).
# Upgrade deliberately: a new major postgres version (e.g. pg18 -> pg19) cannot open the existing data, and needs
# a dump and restore (see Backups). See https://hub.docker.com/r/paradedb/paradedb/tags
# PARADEDB_VERSION=0.26.0-pg18

# If you want to use an external postgres server (profile deploy-nodb), set the connection URL here.
# The server needs the pg_search extension (https://github.com/paradedb/paradedb).
# amcat4_postgres_url=postgresql://amcat:password@host:5432/amcat

# The postgres schema in which AmCAT stores its tables
# amcat4_postgres_schema=amcat

# ## Memory
# Postgres uses the shared buffers as its cache. Set to about 25% of available memory.
# POSTGRES_SHARED_BUFFERS=1GB
# Memory for rebuilding search indexes and vacuuming (per operation)
# POSTGRES_MAINTENANCE_WORK_MEM=512MB
# Shared memory for parallel queries (docker's default of 64MB is too small for large projects)
# POSTGRES_SHM_SIZE=1gb

# ## Data storage
# By default, data is stored on an internal docker volume (called postgres_data),
# which leaves management of the files to Docker (see https://docs.docker.com/storage/volumes/)
# You can also use an explicit (local) folder for data storage instead:
# POSTGRES_DATA_STORAGE=/var/lib/amcat4-postgres

# ## Backups
# Use the standard postgres tools to make backups, e.g. a daily dump:
#   docker compose exec db pg_dump -U amcat -Fc amcat > amcat-$(date +%F).dump
# and restore with pg_restore. For continuous backups (point in time recovery), see e.g. pgBackRest.
